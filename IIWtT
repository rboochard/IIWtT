<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Is It Worth the Time? — Automation ROI Calculator</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            sketch: ['"Architects Daughter"', 'cursive', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            ink: '#18181b',
            paper: '#fafaf9',
            blueprint: '#f4f4f5',
          },
          boxShadow: {
            'sketch': '4px 4px 0px 0px #18181b',
            'sketch-sm': '2px 2px 0px 0px #18181b',
            'sketch-lg': '6px 6px 0px 0px #18181b',
          }
        }
      }
    }
  </script>
  <style>
    /* Custom subtle blueprint grid background */
    .bg-blueprint-grid {
      background-color: #fafaf9;
      background-image: 
        linear-gradient(to right, rgba(24, 24, 27, 0.045) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(24, 24, 27, 0.045) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    /* Custom range slider styling */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }
    input[type="range"]::-webkit-slider-runnable-track {
      height: 8px;
      border-radius: 9999px;
      background: #e4e4e7;
      border: 1.5px solid #18181b;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #facc15;
      border: 2px solid #18181b;
      margin-top: -8.5px;
      box-shadow: 2px 2px 0px #18181b;
      transition: transform 0.1s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.1);
    }

    /* Hide number input arrows for cleaner look while keeping keyboard usability */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      opacity: 1;
    }
  </style>
</head>
<body class="bg-blueprint-grid text-ink font-sans antialiased min-h-screen selection:bg-amber-200 selection:text-ink">

  <!-- Header -->
  <header class="border-b-2 border-ink bg-white/95 backdrop-blur-sm sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="flex items-start sm:items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-amber-300 border-2 border-ink shadow-sketch-sm flex items-center justify-center shrink-0 font-sketch font-bold text-lg">
          ⏱️
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-ink leading-tight">
            Is It Worth the Time?
          </h1>
          <p class="text-xs sm:text-sm text-zinc-600">
            Interactive Automation ROI Calculator inspired by <span class="font-sketch font-semibold text-ink">xkcd #1205</span>
          </p>
        </div>
      </div>

      <!-- Quick Presets Bar -->
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 mr-1">Presets:</span>
        <button type="button" onclick="applyPreset(50, 'day', 1, 'seconds')" class="preset-btn text-xs font-medium px-2.5 py-1.5 rounded-md bg-white hover:bg-amber-100 border border-ink shadow-sketch-sm active:translate-x-[1px] active:translate-y-[1px] transition">
          50/day · 1s → ~1d
        </button>
        <button type="button" onclick="applyPreset(1, 'day', 1, 'minutes')" class="preset-btn text-xs font-medium px-2.5 py-1.5 rounded-md bg-white hover:bg-amber-100 border border-ink shadow-sketch-sm active:translate-x-[1px] active:translate-y-[1px] transition">
          Daily · 1m → ~1d
        </button>
        <button type="button" onclick="applyPreset(1, 'week', 30, 'minutes')" class="preset-btn text-xs font-medium px-2.5 py-1.5 rounded-md bg-white hover:bg-amber-100 border border-ink shadow-sketch-sm active:translate-x-[1px] active:translate-y-[1px] transition">
          Weekly · 30m → ~5d
        </button>
        <button type="button" onclick="applyPreset(5, 'day', 5, 'minutes')" class="preset-btn text-xs font-medium px-2.5 py-1.5 rounded-md bg-white hover:bg-amber-100 border border-ink shadow-sketch-sm active:translate-x-[1px] active:translate-y-[1px] transition">
          5/day · 5m → ~4w
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-8">
    
    <!-- Top Section: Calculator Inputs & Live ROI Output -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      
      <!-- Left Column: Inputs Panel (5 cols) -->
      <section class="lg:col-span-5 bg-white rounded-xl border-2 border-ink shadow-sketch p-5 sm:p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-zinc-200 pb-3">
          <h2 class="text-base sm:text-lg font-bold tracking-tight flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-ink text-white text-xs font-mono">1</span>
            Task Parameters
          </h2>
          <button type="button" id="resetBtn" onclick="resetDefaults()" class="text-xs font-medium text-zinc-500 hover:text-ink underline underline-offset-2">
            Reset
          </button>
        </div>

        <!-- Calendar Mode Toggle -->
        <div class="space-y-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-zinc-600">
            Time Basis (Clock Mode)
          </label>
          <div class="grid grid-cols-2 gap-2 p-1 bg-zinc-100 rounded-lg border border-ink">
            <button type="button" id="mode247Btn" onclick="setScheduleMode('247')" class="py-2 px-3 rounded-md text-xs sm:text-sm font-semibold transition flex flex-col items-center text-center bg-ink text-white shadow-sm">
              <span>24/7 Calendar</span>
              <span class="text-[10px] opacity-80 font-normal">xkcd default (24h/d, 365.25d/y)</span>
            </button>
            <button type="button" id="modeWorkBtn" onclick="setScheduleMode('work')" class="py-2 px-3 rounded-md text-xs sm:text-sm font-semibold transition flex flex-col items-center text-center text-zinc-700 hover:text-ink">
              <span>Work Schedule</span>
              <span class="text-[10px] opacity-80 font-normal">8h/day, 5d/wk, 50wks/yr</span>
            </button>
          </div>
        </div>

        <!-- Input 1: Task Frequency -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="freqValue" class="block text-sm font-bold text-ink">
              How often do you do the task?
            </label>
            <span id="annualRunsBadge" class="text-xs font-mono text-zinc-500 bg-zinc-100 px-2 py-0.5 rounded border border-zinc-300">
              365 runs/yr
            </span>
          </div>
          <div class="flex gap-2">
            <input 
              type="number" 
              id="freqValue" 
              min="0.01" 
              step="any" 
              value="1" 
              class="w-1/2 rounded-lg border-2 border-ink px-3.5 py-2.5 text-base font-mono font-semibold focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white"
            />
            <select 
              id="freqUnit" 
              class="w-1/2 rounded-lg border-2 border-ink px-3 py-2.5 text-sm sm:text-base font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer"
            >
              <option value="hour">times per hour</option>
              <option value="day" selected>times per day</option>
              <option value="week">times per week</option>
              <option value="month">times per month</option>
              <option value="year">times per year</option>
            </select>
          </div>
        </div>

        <!-- Input 2: Time Shaved Off (Direct vs Before/After Toggle) -->
        <div class="space-y-2.5 pt-1 border-t border-zinc-100">
          <div class="flex items-center justify-between gap-2">
            <label class="block text-sm font-bold text-ink">
              How much time do you shave off?
            </label>
            <button 
              type="button" 
              id="toggleBeforeAfterBtn" 
              onclick="toggleBeforeAfterMode()"
              class="text-xs font-semibold text-amber-800 bg-amber-100 hover:bg-amber-200 border border-amber-400 px-2.5 py-1 rounded-md transition"
            >
              Before / After mode
            </button>
          </div>

          <!-- Direct Mode -->
          <div id="directTimeInputGroup" class="flex gap-2">
            <input 
              type="number" 
              id="savedValue" 
              min="0.01" 
              step="any" 
              value="1" 
              class="w-1/2 rounded-lg border-2 border-ink px-3.5 py-2.5 text-base font-mono font-semibold focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white"
            />
            <select 
              id="savedUnit" 
              class="w-1/2 rounded-lg border-2 border-ink px-3 py-2.5 text-sm sm:text-base font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer"
            >
              <option value="seconds">seconds</option>
              <option value="minutes" selected>minutes</option>
              <option value="hours">hours</option>
              <option value="days">days</option>
            </select>
          </div>

          <!-- Before & After Mode (Hidden by default) -->
          <div id="beforeAfterInputGroup" class="hidden space-y-3 bg-zinc-50 p-3.5 rounded-lg border border-zinc-300">
            <div class="grid grid-cols-2 gap-2.5">
              <div>
                <label for="currentDurValue" class="block text-xs font-semibold text-zinc-600 mb-1">Current Duration</label>
                <div class="flex gap-1">
                  <input type="number" id="currentDurValue" min="0" step="any" value="5" class="w-1/2 rounded border border-ink px-2 py-1.5 text-sm font-mono font-semibold bg-white" />
                  <select id="currentDurUnit" class="w-1/2 rounded border border-ink px-1.5 py-1.5 text-xs font-semibold bg-white">
                    <option value="seconds">sec</option>
                    <option value="minutes" selected>min</option>
                    <option value="hours">hr</option>
                  </select>
                </div>
              </div>
              <div>
                <label for="newDurValue" class="block text-xs font-semibold text-zinc-600 mb-1">Automated Duration</label>
                <div class="flex gap-1">
                  <input type="number" id="newDurValue" min="0" step="any" value="1" class="w-1/2 rounded border border-ink px-2 py-1.5 text-sm font-mono font-semibold bg-white" />
                  <select id="newDurUnit" class="w-1/2 rounded border border-ink px-1.5 py-1.5 text-xs font-semibold bg-white">
                    <option value="seconds">sec</option>
                    <option value="minutes" selected>min</option>
                    <option value="hours">hr</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between text-xs pt-1 border-t border-zinc-200">
              <span class="text-zinc-600">Net time shaved per run:</span>
              <span id="computedShavedPreview" class="font-mono font-bold text-emerald-700">4 minutes (80% faster)</span>
            </div>
          </div>
        </div>

        <!-- Input 3: Time Horizon -->
        <div class="space-y-2 pt-1 border-t border-zinc-100">
          <div class="flex items-center justify-between">
            <label for="horizonSlider" class="block text-sm font-bold text-ink">
              Time Horizon
            </label>
            <div class="flex items-center gap-1.5">
              <span id="horizonLabel" class="font-mono font-bold text-sm bg-amber-200 border border-ink px-2.5 py-0.5 rounded-md">
                5 Years
              </span>
              <span id="xkcdHorizonTag" class="text-[11px] font-sketch text-zinc-600">(xkcd chart)</span>
            </div>
          </div>
          <input 
            type="range" 
            id="horizonSlider" 
            min="1" 
            max="10" 
            step="1" 
            value="5" 
            class="w-full"
          />
          <div class="flex justify-between text-[11px] font-mono text-zinc-400 px-0.5">
            <span>1 yr</span>
            <span>3 yrs</span>
            <span class="text-ink font-bold">5 yrs</span>
            <span>7 yrs</span>
            <span>10 yrs</span>
          </div>
        </div>

        <!-- Input 4: Optional Reality Check -->
        <div class="pt-3 border-t-2 border-dashed border-zinc-300 space-y-2">
          <div class="flex items-center justify-between">
            <label for="buildHoursInput" class="text-sm font-bold text-ink flex items-center gap-1.5">
              <span>🛠️ Estimated Build Time</span>
              <span class="text-[11px] font-normal text-zinc-500">(Optional)</span>
            </label>
            <span class="text-xs text-zinc-500">in hours</span>
          </div>
          <div class="flex gap-2 items-center">
            <input 
              type="number" 
              id="buildHoursInput" 
              min="0" 
              step="any" 
              placeholder="e.g. 6" 
              class="w-full rounded-lg border-2 border-zinc-300 focus:border-ink px-3.5 py-2 text-sm font-mono font-semibold focus:outline-none focus:ring-2 focus:ring-amber-400 bg-zinc-50 focus:bg-white transition"
            />
            <button type="button" onclick="document.getElementById('buildHoursInput').value=''; updateCalculator();" class="text-xs px-2.5 py-2 text-zinc-500 hover:text-ink border border-zinc-300 rounded-lg bg-white">
              Clear
            </button>
          </div>
        </div>
      </section>

      <!-- Right Column: Headline Output & Breakdown (7 cols) -->
      <section class="lg:col-span-7 space-y-6">
        
        <!-- Primary Headline Result Card -->
        <div class="bg-white rounded-xl border-2 border-ink shadow-sketch p-6 sm:p-8 relative overflow-hidden">
          <!-- Decorative corner badge -->
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-amber-300 border border-ink text-ink">
              <span id="modeIndicatorDot" class="w-2 h-2 rounded-full bg-ink"></span>
              <span id="modeIndicatorText">24/7 Calendar Time</span>
            </span>
            <span class="text-xs font-mono text-zinc-500" id="formulaSummary">
              1/day × 1m × 5 yrs
            </span>
          </div>

          <p class="text-sm sm:text-base font-medium text-zinc-600">
            Across <strong id="headlineHorizon" class="text-ink">5 years</strong>, you can spend up to:
          </p>

          <!-- Giant Headline Number -->
          <div class="my-3 sm:my-4">
            <div id="headlineResult" class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink leading-tight">
              1 day, 6 hours, 26 minutes
            </div>
            <div id="secondaryExactResult" class="mt-2 text-sm sm:text-base font-mono text-zinc-600 flex flex-wrap items-center gap-x-3 gap-y-1">
              <span>= <strong>30.44 hours</strong> total</span>
              <span class="text-zinc-300">|</span>
              <span><strong>1,826 minutes</strong></span>
              <span class="text-zinc-300">|</span>
              <span id="xkcdStyleRounding" class="font-sketch text-amber-800 bg-amber-100 px-2 py-0.5 rounded border border-amber-300">
                xkcd label: ~1 DAY
              </span>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed border-t border-zinc-200 pt-3">
            ...working on automating or streamlining this task before you spend more time optimizing than you save.
          </p>

          <!-- Breakdown Metrics Grid -->
          <div class="grid grid-cols-3 gap-3 sm:gap-4 mt-6">
            <div class="bg-zinc-50 rounded-lg border border-ink p-3 sm:p-4">
              <div class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-zinc-500">Saved / Week</div>
              <div id="savedPerWeek" class="text-base sm:text-xl font-extrabold font-mono text-ink mt-1">7m 0s</div>
              <div id="runsPerWeek" class="text-[11px] text-zinc-500 mt-0.5">7 runs/wk</div>
            </div>
            <div class="bg-zinc-50 rounded-lg border border-ink p-3 sm:p-4">
              <div class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-zinc-500">Saved / Year</div>
              <div id="savedPerYear" class="text-base sm:text-xl font-extrabold font-mono text-ink mt-1">6h 5m</div>
              <div id="runsPerYear" class="text-[11px] text-zinc-500 mt-0.5">365 runs/yr</div>
            </div>
            <div class="bg-amber-50 rounded-lg border border-ink p-3 sm:p-4">
              <div class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-amber-900">Full Horizon</div>
              <div id="savedTotalHorizon" class="text-base sm:text-xl font-extrabold font-mono text-ink mt-1">30h 26m</div>
              <div id="runsTotalHorizon" class="text-[11px] text-amber-800 mt-0.5">1,826 runs</div>
            </div>
          </div>
        </div>

        <!-- Reality Check / Break-Even Verdict Card (Dynamic) -->
        <div id="realityCheckCard" class="rounded-xl border-2 border-ink shadow-sketch p-5 sm:p-6 transition-colors bg-white">
          <div id="realityCheckEmpty" class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h3 class="text-sm sm:text-base font-bold text-ink">Want a Reality Check?</h3>
              <p class="text-xs sm:text-sm text-zinc-600 mt-0.5">
                Enter your <strong>Estimated Build Time</strong> on the left to calculate your exact break-even date and net ROI.
              </p>
            </div>
            <button type="button" onclick="document.getElementById('buildHoursInput').value='8'; updateCalculator();" class="shrink-0 text-xs font-semibold px-3 py-2 rounded-lg bg-zinc-100 hover:bg-amber-200 border border-ink transition">
              Try "8 hours" →
            </button>
          </div>

          <div id="realityCheckActive" class="hidden space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2.5">
                <span id="verdictBadge" class="text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full border border-ink">
                  WORTH IT
                </span>
                <h3 id="verdictHeadline" class="text-base sm:text-lg font-extrabold text-ink">
                  You break even in 1 year, 3 months!
                </h3>
              </div>
              <span id="netRoiPill" class="text-xs font-mono font-bold px-2.5 py-1 rounded bg-white border border-ink">
                Net: +22.4 hrs
              </span>
            </div>

            <!-- Visual Progress Bar comparing Build Time vs Break-Even Budget -->
            <div class="space-y-1.5">
              <div class="flex justify-between text-xs font-medium text-zinc-700">
                <span>Build Effort: <strong id="buildEffortLabel" class="font-mono">8.0 hrs</strong></span>
                <span>Max Budget: <strong id="maxBudgetLabel" class="font-mono">30.4 hrs</strong></span>
              </div>
              <div class="w-full h-4 bg-zinc-200 rounded-full border border-ink overflow-hidden p-0.5">
                <div id="roiProgressBar" class="h-full rounded-full transition-all duration-300 bg-emerald-500" style="width: 26%"></div>
              </div>
              <p id="verdictDetailText" class="text-xs sm:text-sm text-zinc-700 pt-1">
                After breaking even around <strong>February 2028</strong>, every remaining year saves you pure time.
              </p>
            </div>
          </div>
        </div>

      </section>
    </div>

    <!-- Bottom Section: Interactive xkcd 1205 Reference Matrix -->
    <section class="bg-white rounded-xl border-2 border-ink shadow-sketch p-5 sm:p-7 space-y-5">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b-2 border-ink pb-4">
        <div>
          <div class="inline-block text-xs font-sketch font-bold uppercase tracking-wider bg-zinc-100 border border-ink px-2.5 py-0.5 rounded mb-1.5">
            Interactive Reference Chart
          </div>
          <h2 class="text-xl sm:text-2xl font-sketch font-bold text-ink tracking-wide">
            HOW LONG CAN YOU WORK ON MAKING A ROUTINE TASK MORE EFFICIENT BEFORE YOU'RE SPENDING MORE TIME THAN YOU SAVE?
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 mt-1">
            Click any cell to load those values into the calculator. The closest cell to your current inputs highlights automatically in <span class="bg-amber-300 px-1.5 py-0.5 rounded border border-ink font-semibold text-ink">amber</span>.
          </p>
        </div>

        <div class="flex items-center gap-3 text-xs shrink-0">
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded bg-amber-300 border border-ink inline-block"></span>
            <span class="font-medium text-zinc-700">Closest Match</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded bg-zinc-700 border border-ink inline-block"></span>
            <span class="font-medium text-zinc-700">Exceeds Horizon</span>
          </div>
        </div>
      </div>

      <!-- Responsive Matrix Container -->
      <div class="overflow-x-auto pb-2">
        <div class="min-w-[680px]">
          <!-- Top Axis Label -->
          <div class="grid grid-cols-7 mb-2">
            <div></div>
            <div class="col-span-6 text-center font-sketch font-bold text-sm sm:text-base tracking-wider text-ink flex items-center justify-center gap-3">
              <span class="h-[2px] bg-ink flex-1 max-w-[100px]"></span>
              <span>HOW OFTEN YOU DO THE TASK</span>
              <span class="h-[2px] bg-ink flex-1 max-w-[100px]"></span>
            </div>
          </div>

          <div class="flex items-stretch gap-3">
            <!-- Left Vertical Axis Label -->
            <div class="flex flex-col items-center justify-center w-8 shrink-0 select-none">
              <div class="w-[2px] flex-1 bg-ink max-h-16 mb-2"></div>
              <span class="font-sketch font-bold text-xs sm:text-sm text-center leading-tight tracking-wide text-ink">
                HOW<br>MUCH<br>TIME<br>YOU<br>SHAVE<br>OFF
              </span>
              <div class="w-[2px] flex-1 bg-ink max-h-16 mt-2"></div>
            </div>

            <!-- The 9x6 Grid Table -->
            <div class="flex-1">
              <table class="w-full border-collapse table-fixed" id="xkcdMatrixTable">
                <thead>
                  <tr>
                    <th class="w-28 p-2"></th>
                    <th class="p-2 text-center font-sketch font-bold text-sm sm:text-base text-ink">50/DAY</th>
                    <th class="p-2 text-center font-sketch font-bold text-sm sm:text-base text-ink">5/DAY</th>
                    <th class="p-2 text-center font-sketch font-bold text-sm sm:text-base text-ink">DAILY</th>
                    <th class="p-2 text-center font-sketch font-bold text-sm sm:text-base text-ink">WEEKLY</th>
                    <th class="p-2 text-center font-sketch font-bold text-sm sm:text-base text-ink">MONTHLY</th>
