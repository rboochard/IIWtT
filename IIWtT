    function toggleBeforeAfterMode() {
      state.beforeAfterMode = !state.beforeAfterMode;
      if (state.beforeAfterMode) {
        el.directTimeInputGroup.classList.add('hidden');
        el.beforeAfterInputGroup.classList.remove('hidden');
        el.toggleBeforeAfterBtn.textContent = 'Direct input mode';
      } else {
        el.directTimeInputGroup.classList.remove('hidden');
        el.beforeAfterInputGroup.classList.add('hidden');
        el.toggleBeforeAfterBtn.textContent = 'Before / After mode';
      }
      updateCalculator();
    }

    function applyPreset(freqVal, freqUnit, savedVal, savedUnit) {
      if (state.beforeAfterMode) {
        toggleBeforeAfterMode();
      }
      el.freqValue.value = freqVal;
      el.freqUnit.value = freqUnit;
      el.savedValue.value = savedVal;
      el.savedUnit.value = savedUnit;
      el.horizonSlider.value = 5;
      updateCalculator();
    }

    function resetDefaults() {
      state.scheduleMode = '247';
      if (state.beforeAfterMode) toggleBeforeAfterMode();
      el.freqValue.value = 1;
      el.freqUnit.value = 'day';
      el.savedValue.value = 1;
      el.savedUnit.value = 'minutes';
      el.horizonSlider.value = 5;
      el.buildHoursInput.value = '';
      setScheduleMode('247');
    }

    /**
     * Core Calculation & DOM Rendering
     */
    function updateCalculator() {
      const mode = state.scheduleMode;
      const c = getTimeConstants(mode);

      // 1. Read Frequency
      const freqVal = Math.max(0, parseFloat(el.freqValue.value) || 0);
      const freqUnit = el.freqUnit.value;
      const annualRuns = frequencyToAnnualRuns(freqVal, freqUnit, mode);

      // 2. Read Time Shaved Off (in seconds)
      let savedSecondsPerRun = 0;
      if (state.beforeAfterMode) {
        const curVal = Math.max(0, parseFloat(el.currentDurValue.value) || 0);
        const curUnit = el.currentDurUnit.value;
        const newVal = Math.max(0, parseFloat(el.newDurValue.value) || 0);
        const newUnit = el.newDurUnit.value;

        const curSec = unitToSeconds(curVal, curUnit, mode);
        const newSec = unitToSeconds(newVal, newUnit, mode);
        savedSecondsPerRun = Math.max(0, curSec - newSec);

        const pctFaster = curSec > 0 ? Math.round((savedSecondsPerRun / curSec) * 100) : 0;
        el.computedShavedPreview.textContent = `${formatDetailedDuration(savedSecondsPerRun, mode)} (${pctFaster}% faster)`;
      } else {
        const sVal = Math.max(0, parseFloat(el.savedValue.value) || 0);
        const sUnit = el.savedUnit.value;
        savedSecondsPerRun = unitToSeconds(sVal, sUnit, mode);
      }

      // 3. Read Horizon
      const horizonYears = parseInt(el.horizonSlider.value, 10) || 5;
      el.horizonLabel.textContent = `${horizonYears} ${horizonYears === 1 ? 'Year' : 'Years'}`;
      el.headlineHorizon.textContent = `${horizonYears} ${horizonYears === 1 ? 'year' : 'years'}`;
      el.matrixHorizonFoot.textContent = `${horizonYears} ${horizonYears === 1 ? 'yr' : 'yrs'}`;
      el.xkcdHorizonTag.classList.toggle('hidden', horizonYears !== 5);

      // 4. Compute Totals
      const totalRunsHorizon = annualRuns * horizonYears;
      const runsPerWeek = annualRuns / c.weeksPerYear;

      const secondsSavedPerWeek = runsPerWeek * savedSecondsPerRun;
      const secondsSavedPerYear = annualRuns * savedSecondsPerRun;
      const totalSecondsSavedHorizon = totalRunsHorizon * savedSecondsPerRun;

      const totalHoursHorizon = totalSecondsSavedHorizon / 3600;
      const totalMinutesHorizon = totalSecondsSavedHorizon / 60;

      // 5. Update Badges & Headline
      el.annualRunsBadge.textContent = `${Math.round(annualRuns).toLocaleString()} runs/yr`;
      
      const shortUnitMap = { hour: '/hr', day: '/day', week: '/wk', month: '/mo', year: '/yr' };
      const shortSavedLabel = savedSecondsPerRun < 60 
        ? `${Math.round(savedSecondsPerRun)}s` 
        : savedSecondsPerRun < 3600 
          ? `${Math.round(savedSecondsPerRun / 60 * 10) / 10}m` 
          : `${Math.round(savedSecondsPerRun / 3600 * 10) / 10}h`;
      el.formulaSummary.textContent = `${freqVal}${shortUnitMap[freqUnit]} × ${shortSavedLabel} × ${horizonYears}y`;

      el.headlineResult.textContent = formatDetailedDuration(totalSecondsSavedHorizon, mode);

      const formattedHrs = totalHoursHorizon >= 100 
        ? Math.round(totalHoursHorizon).toLocaleString() 
        : (Math.round(totalHoursHorizon * 100) / 100).toLocaleString();
      const formattedMins = Math.round(totalMinutesHorizon).toLocaleString();
      const xkcdTag = formatXkcdStyleLabel(totalSecondsSavedHorizon, mode);

      el.secondaryExactResult.innerHTML = `
        <span>= <strong>${formattedHrs} hours</strong> total</span>
        <span class="text-zinc-300">|</span>
        <span><strong>${formattedMins} minutes</strong></span>
        <span class="text-zinc-300">|</span>
        <span class="font-sketch text-amber-800 bg-amber-100 px-2 py-0.5 rounded border border-amber-300">
          xkcd style: ~${xkcdTag}
        </span>
      `;

      // 6. Update Breakdown Cards
      el.savedPerWeek.textContent = formatCompactDuration(secondsSavedPerWeek, mode);
      el.runsPerWeek.textContent = `${(Math.round(runsPerWeek * 10) / 10).toLocaleString()} runs/wk`;

      el.savedPerYear.textContent = formatCompactDuration(secondsSavedPerYear, mode);
      el.runsPerYear.textContent = `${Math.round(annualRuns).toLocaleString()} runs/yr`;

      el.savedTotalHorizon.textContent = formatCompactDuration(totalSecondsSavedHorizon, mode);
      el.runsTotalHorizon.textContent = `${Math.round(totalRunsHorizon).toLocaleString()} runs`;

      // 7. Update Reality Check / Break-Even Analysis
      const rawBuild = el.buildHoursInput.value.trim();
      const buildHours = rawBuild === '' ? NaN : parseFloat(rawBuild);

      if (!isNaN(buildHours) && buildHours >= 0) {
        el.realityCheckEmpty.classList.add('hidden');
        el.realityCheckActive.classList.remove('hidden');

        const buildSeconds = buildHours * 3600;
        const netHours = totalHoursHorizon - buildHours;
        const isWorthIt = buildHours <= totalHoursHorizon && totalHoursHorizon > 0;

        el.buildEffortLabel.textContent = `${buildHours.toLocaleString()} hrs`;
        el.maxBudgetLabel.textContent = `${formattedHrs} hrs`;

        const ratioPct = totalHoursHorizon > 0 ? Math.min(100, Math.round((buildHours / totalHoursHorizon) * 100)) : 100;
        el.roiProgressBar.style.width = `${Math.max(4, ratioPct)}%`;

        if (isWorthIt) {
          el.realityCheckCard.className = 'rounded-xl border-2 border-ink shadow-sketch p-5 sm:p-6 transition-colors bg-emerald-50/90';
          el.verdictBadge.className = 'text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full border border-ink bg-emerald-400 text-ink';
          el.verdictBadge.textContent = 'WORTH IT';
          el.roiProgressBar.className = 'h-full rounded-full transition-all duration-300 bg-emerald-500';

          const yearsToBreakEven = secondsSavedPerYear > 0 ? buildSeconds / secondsSavedPerYear : Infinity;
          const breakEvenDurationStr = formatDetailedDuration(yearsToBreakEven * c.secondsPerYear, mode);
          el.verdictHeadline.textContent = buildHours === 0 
            ? 'Instant payoff!' 
            : `Breaks even in ${breakEvenDurationStr}`;

          el.netRoiPill.textContent = `Net Saved: +${(Math.round(netHours * 10) / 10).toLocaleString()} hrs`;

          // Estimate calendar break-even date
          const breakEvenDate = new Date(Date.now() + yearsToBreakEven * 365.25 * 86400 * 1000);
          const dateStr = breakEvenDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
          el.verdictDetailText.innerHTML = `You'll recoup your <strong>${buildHours}h</strong> investment around <strong>${dateStr}</strong>, netting <strong>+${(Math.round(netHours * 10) / 10).toLocaleString()} hours</strong> (${formatDetailedDuration(netHours * 3600, mode)}) by year ${horizonYears}.`;
        } else {
          el.realityCheckCard.className = 'rounded-xl border-2 border-ink shadow-sketch p-5 sm:p-6 transition-colors bg-rose-50/90';
          el.verdictBadge.className = 'text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full border border-ink bg-rose-400 text-ink';
          el.verdictBadge.textContent = 'NOT WORTH IT';
          el.roiProgressBar.className = 'h-full rounded-full transition-all duration-300 bg-rose-500';

          const yearsToBreakEven = secondsSavedPerYear > 0 ? buildSeconds / secondsSavedPerYear : Infinity;
          el.verdictHeadline.textContent = isFinite(yearsToBreakEven) 
            ? `Takes ${Math.round(yearsToBreakEven * 10) / 10} yrs to break even` 
            : 'Never breaks even';

          el.netRoiPill.textContent = `Net Loss: ${(Math.round(netHours * 10) / 10).toLocaleString()} hrs`;
          el.verdictDetailText.innerHTML = `Spending <strong>${buildHours} hours</strong> exceeds the <strong>${formattedHrs} hours</strong> you would save over ${horizonYears} ${horizonYears === 1 ? 'year' : 'years'}. Try a simpler hack or partial automation!`;
        }
      } else {
        el.realityCheckCard.className = 'rounded-xl border-2 border-ink shadow-sketch p-5 sm:p-6 transition-colors bg-white';
        el.realityCheckEmpty.classList.remove('hidden');
        el.realityCheckActive.classList.add('hidden');
      }

      // 8. Re-render Interactive Reference Matrix & Highlight Closest Cell
      renderMatrix(annualRuns, savedSecondsPerRun, horizonYears, mode);
    }

    /**
     * Render the 9x6 xkcd-style matrix and highlight the nearest matching cell
     */
    function renderMatrix(currentAnnualRuns, currentSavedSeconds, horizonYears, mode) {
      const c = getTimeConstants(mode);
      const maxHorizonSeconds = horizonYears * c.secondsPerYear;

      // Find closest row and column using logarithmic distance so scale feels intuitive
      let bestRowIdx = -1;
      let bestColIdx = -1;

      if (currentAnnualRuns > 0 && currentSavedSeconds > 0) {
        let minRowDist = Infinity;
        MATRIX_ROWS.forEach((row, rIdx) => {
          const dist = Math.abs(Math.log10(row.seconds) - Math.log10(currentSavedSeconds));
          if (dist < minRowDist) {
            minRowDist = dist;
            bestRowIdx = rIdx;
          }
        });

        let minColDist = Infinity;
        MATRIX_COLS.forEach((col, cIdx) => {
          const colRuns = frequencyToAnnualRuns(col.freqVal, col.freqUnit, mode);
          const dist = Math.abs(Math.log10(colRuns) - Math.log10(currentAnnualRuns));
          if (dist < minColDist) {
            minColDist = dist;
            bestColIdx = cIdx;
          }
        });
      }

      let html = '';
      MATRIX_ROWS.forEach((row, rIdx) => {
        html += `<tr>`;
        // Row Header
        html += `
          <td class="py-2.5 px-3 text-right font-sketch font-bold text-xs sm:text-sm text-ink bg-paper border-b border-r-2 border-ink select-none whitespace-nowrap">
            ${row.label}
          </td>
        `;

        MATRIX_COLS.forEach((col, cIdx) => {
          const colAnnualRuns = frequencyToAnnualRuns(col.freqVal, col.freqUnit, mode);
          const cellSavedSeconds = colAnnualRuns * horizonYears * row.seconds;
          const isShaded = cellSavedSeconds >= maxHorizonSeconds;
          const isActive = (rIdx === bestRowIdx && cIdx === bestColIdx);

          const cellText = isShaded ? '' : formatXkcdStyleLabel(cellSavedSeconds, mode);

          let cellClasses = 'border border-ink text-center font-sketch text-xs sm:text-sm py-3 px-1.5 cursor-pointer transition select-none ';
          if (isActive && isShaded) {
            cellClasses += 'bg-zinc-800 text-amber-300 ring-2 ring-inset ring-amber-300 font-bold';
          } else if (isActive) {
            cellClasses += 'bg-amber-300 text-ink font-extrabold shadow-inner';
          } else if (isShaded) {
            cellClasses += 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300';
          } else {
            cellClasses += 'bg-white hover:bg-amber-100 text-ink font-semibold';
          }

          html += `
            <td 
              class="${cellClasses}"
              title="Click to load: ${col.label}, shave ${row.label}"
              onclick="selectMatrixCell(${col.freqVal}, '${col.freqUnit}', ${row.savedVal}, '${row.savedUnit}')"
            >
              ${isShaded ? (isActive ? 'MAXED' : '') : cellText}
            </td>
          `;
        });

        html += `</tr>`;
      });

      el.matrixBody.innerHTML = html;
    }

    function selectMatrixCell(freqVal, freqUnit, savedVal, savedUnit) {
      if (state.beforeAfterMode) {
        toggleBeforeAfterMode();
      }
      el.freqValue.value = freqVal;
      el.freqUnit.value = freqUnit;
      el.savedValue.value = savedVal;
      el.savedUnit.value = savedUnit;
      updateCalculator();
    }

    /**
     * Attach Event Listeners & Initialize
     */
    function init() {
      const inputs = [
        el.freqValue, el.freqUnit,
        el.savedValue, el.savedUnit,
        el.currentDurValue, el.currentDurUnit,
        el.newDurValue, el.newDurUnit,
        el.horizonSlider, el.buildHoursInput
      ];

      inputs.forEach(input => {
        input.addEventListener('input', updateCalculator);
        input.addEventListener('change', updateCalculator);
      });

      updateCalculator();
    }

    window.addEventListener('DOMContentLoaded', init);
  </script>
