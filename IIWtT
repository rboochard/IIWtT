    /**
     * Conversion Helpers
     */
    function getTimeConstants(mode) {
      if (mode === 'work') {
        // Standard Work Schedule: 8 hrs/day, 5 days/week, 50 weeks/year (250 workdays/yr, 2,000 hrs/yr)
        return {
          hoursPerDay: 8,
          daysPerWeek: 5,
          weeksPerYear: 50,
          daysPerYear: 250,
          hoursPerYear: 2000,
          secondsPerDay: 8 * 3600,
          secondsPerWeek: 40 * 3600,
          secondsPerMonth: (250 / 12) * 8 * 3600,
          secondsPerYear: 2000 * 3600
        };
      } else {
        // Continuous 24/7 Calendar (matches xkcd 1205 math: 365.25 days/yr)
        return {
          hoursPerDay: 24,
          daysPerWeek: 7,
          weeksPerYear: 365.25 / 7,
          daysPerYear: 365.25,
          hoursPerYear: 365.25 * 24,
          secondsPerDay: 86400,
          secondsPerWeek: 7 * 86400,
          secondsPerMonth: (365.25 / 12) * 86400,
          secondsPerYear: 365.25 * 86400
        };
      }
    }

    function unitToSeconds(val, unit, mode) {
      const c = getTimeConstants(mode);
      switch (unit) {
        case 'seconds': return val;
        case 'minutes': return val * 60;
        case 'hours':   return val * 3600;
        case 'days':    return val * c.secondsPerDay;
        default:        return val;
      }
    }

    function frequencyToAnnualRuns(freqVal, freqUnit, mode) {
      const c = getTimeConstants(mode);
      switch (freqUnit) {
        case 'hour':  return freqVal * c.hoursPerYear;
        case 'day':   return freqVal * c.daysPerYear;
        case 'week':  return freqVal * c.weeksPerYear;
        case 'month': return freqVal * 12;
        case 'year':  return freqVal;
        default:      return freqVal * c.daysPerYear;
      }
    }

    /**
     * Format duration intuitively into human-readable units
     * Respects whether a "day" is 24h (calendar) or 8h (workday)
     */
    function formatDetailedDuration(totalSeconds, mode) {
      if (totalSeconds <= 0) return '0 seconds';
      const c = getTimeConstants(mode);
      const secPerDay = c.secondsPerDay;
      const secPerMonth = c.secondsPerMonth;
      const secPerYear = c.secondsPerYear;

      if (totalSeconds < 60) {
        const s = Math.round(totalSeconds * 10) / 10;
        return `${s} ${s === 1 ? 'second' : 'seconds'}`;
      }

      const parts = [];
      let rem = totalSeconds;

      const years = Math.floor(rem / secPerYear);
      if (years > 0) {
        parts.push(`${years} ${years === 1 ? 'year' : 'years'}`);
        rem -= years * secPerYear;
      }

      const months = Math.floor(rem / secPerMonth);
      if (months > 0 && parts.length < 3) {
        parts.push(`${months} ${months === 1 ? 'month' : 'months'}`);
        rem -= months * secPerMonth;
      }

      const days = Math.floor(rem / secPerDay);
      if (days > 0 && parts.length < 3) {
        parts.push(`${days} ${days === 1 ? 'day' : 'days'}`);
        rem -= days * secPerDay;
      }

      const hours = Math.floor(rem / 3600);
      if (hours > 0 && parts.length < 3) {
        parts.push(`${hours} ${hours === 1 ? 'hour' : 'hours'}`);
        rem -= hours * 3600;
      }

      const minutes = Math.floor(rem / 60);
      if (minutes > 0 && parts.length < 3 && years === 0) {
        parts.push(`${minutes} ${minutes === 1 ? 'minute' : 'minutes'}`);
        rem -= minutes * 60;
      }

      if (parts.length === 0) {
        const secs = Math.round(totalSeconds);
        return `${secs} ${secs === 1 ? 'second' : 'seconds'}`;
      }

      return parts.join(', ');
    }

    /**
     * Compact formatter for metric cards (e.g., "6h 5m", "30h 26m", "14d 4h")
     */
    function formatCompactDuration(totalSeconds, mode) {
      if (totalSeconds <= 0) return '0s';
      const c = getTimeConstants(mode);
      if (totalSeconds < 60) return `${Math.round(totalSeconds)}s`;
      if (totalSeconds < 3600) {
        const m = Math.floor(totalSeconds / 60);
        const s = Math.round(totalSeconds % 60);
        return s > 0 ? `${m}m ${s}s` : `${m}m`;
      }
      if (totalSeconds < c.secondsPerDay * 2) {
        const h = Math.floor(totalSeconds / 3600);
        const m = Math.round((totalSeconds % 3600) / 60);
        return m > 0 ? `${h}h ${m}m` : `${h}h`;
      }
      const d = Math.floor(totalSeconds / c.secondsPerDay);
      const h = Math.round((totalSeconds % c.secondsPerDay) / 3600);
      return h > 0 ? `${d}d ${h}h` : `${d}d`;
    }

    /**
     * Classic xkcd 1205 single-unit rounded label (e.g., "1 DAY", "4 WEEKS", "9 MONTHS")
     */
    function formatXkcdStyleLabel(totalSeconds, mode) {
      if (totalSeconds <= 0) return '0 SECONDS';
      const c = getTimeConstants(mode);
      const days = totalSeconds / c.secondsPerDay;
      const weeks = totalSeconds / c.secondsPerWeek;
      const months = totalSeconds / c.secondsPerMonth;
      const years = totalSeconds / c.secondsPerYear;

      if (totalSeconds < 55) {
        const s = Math.max(1, Math.round(totalSeconds));
        return `${s} ${s === 1 ? 'SECOND' : 'SECONDS'}`;
      }
      if (totalSeconds < 3300) {
        const m = Math.max(1, Math.round(totalSeconds / 60));
        return `${m} ${m === 1 ? 'MINUTE' : 'MINUTES'}`;
      }
      if (days < 0.85) {
        const h = Math.max(1, Math.round(totalSeconds / 3600));
        return `${h} ${h === 1 ? 'HOUR' : 'HOURS'}`;
      }
      if (days < 13.5) {
        const d = Math.max(1, Math.round(days));
        return `${d} ${d === 1 ? 'DAY' : 'DAYS'}`;
      }
      if (weeks < 8.5) {
        const w = Math.max(1, Math.round(weeks));
        return `${w} ${w === 1 ? 'WEEK' : 'WEEKS'}`;
      }
      if (months < 11.5) {
        const mo = Math.max(1, Math.round(months));
        return `${mo} ${mo === 1 ? 'MONTH' : 'MONTHS'}`;
      }
      const yr = Math.round(years * 10) / 10;
      return `${yr} ${yr === 1 ? 'YEAR' : 'YEARS'}`;
    }

    /**
     * UI Actions & Mode Switches
     */
    function setScheduleMode(mode) {
      state.scheduleMode = mode;
      if (mode === '247') {
        el.mode247Btn.className = 'py-2 px-3 rounded-md text-xs sm:text-sm font-semibold transition flex flex-col items-center text-center bg-ink text-white shadow-sm';
        el.modeWorkBtn.className = 'py-2 px-3 rounded-md text-xs sm:text-sm font-semibold transition flex flex-col items-center text-center text-zinc-700 hover:text-ink';
        el.modeIndicatorText.textContent = '24/7 Calendar Time';
        el.matrixModeFoot.textContent = '24/7 Calendar';
      } else {
        el.modeWorkBtn.className = 'py-2 px-3 rounded-md text-xs sm:text-sm font-semibold transition flex flex-col items-center text-center bg-ink text-white shadow-sm';
        el.mode247Btn.className = 'py-2 px-3 rounded-md text-xs sm:text-sm font-semibold transition flex flex-col items-center text-center text-zinc-700 hover:text-ink';
        el.modeIndicatorText.textContent = 'Work Time (8h/day · 40h/wk)';
        el.matrixModeFoot.textContent = '8-hr Workdays';
      }
      updateCalculator();
